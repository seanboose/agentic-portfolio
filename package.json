{
  "name": "portfolio",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "workspaces": ["shared", "server", "client", "e2e"],
  "scripts": {
    "postinstall": "npm run build -w shared",
    "dev": "npm run build -w shared && concurrently \"npm run dev -w shared\" \"npm run dev -w server\" \"npm run dev -w client\"",
    "build": "npm run build -w shared && npm run build -w server && npm run build -w client",
    "start": "npm run start -w server",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "test": "npm run test -w shared",
    "test:e2e": "npm run test:e2e -w e2e"
  },
  "devDependencies": {
    "@eslint/js": "^9.18.0",
    "concurrently": "^9.1.0",
    "eslint": "^9.18.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-react-hooks": "^5.1.0",
    "eslint-plugin-react-refresh": "^0.4.18",
    "globals": "^15.14.0",
    "prettier": "^3.4.2",
    "typescript": "^5.9.0",
    "typescript-eslint": "^8.20.0"
  }
}
